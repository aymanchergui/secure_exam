# ============================================================
# SecureExam - Exemple de variables d'environnement backend
# Copier ce fichier vers backend/.env puis remplacer les valeurs.
# ============================================================

# ============================================================
# JWT - Authentification utilisateurs
# ============================================================

JWT_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120


# ============================================================
# Compte enseignant initial / de démonstration
# ============================================================

TEACHER_USERNAME=prof
TEACHER_PASSWORD=CHANGE_ME_TEACHER_PASSWORD


# ============================================================
# Agent SecureExam
# IMPORTANT :
# cette valeur doit être EXACTEMENT la même côté backend
# et côté service secureexam-agent sur NixOS.
# ============================================================

SECUREEXAM_AGENT_TOKEN=CHANGE_ME_WITH_A_LONG_RANDOM_AGENT_SECRET


# ============================================================
# URL publique de la plateforme / tunnel
# Exemple avec ngrok.
# ============================================================

SECUREEXAM_PLATFORM_URL=https://xxxxx.ngrok-free.app


# ============================================================
# SMTP - Envoi des demandes de support via Outlook / Microsoft 365
# ============================================================

SMTP_HOST=smtp.office365.com
SMTP_PORT=587

SMTP_USERNAME=prenom.nom@isen.fr
SMTP_PASSWORD=CHANGE_ME_OUTLOOK_PASSWORD

SMTP_FROM_EMAIL=prenom.nom@isen.fr
SUPPORT_TO_EMAIL=support@isen.fr