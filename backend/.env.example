# ============================================================
# ISEN SecureExam - Exemple de variables d'environnement backend
# Copier ce fichier vers .env puis remplacer les valeurs.
# Ne jamais mettre de vrais secrets dans ce fichier.
# ============================================================


# ============================================================
# Configuration SMTP
# Utilisée pour envoyer les demandes de support par email.
# ============================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_app_password
SMTP_FROM_EMAIL=replace_with_sender_email
SUPPORT_TO_EMAIL=replace_with_support_email


# ============================================================
# Configuration JWT
# Utilisée pour sécuriser l'authentification enseignant.
# ============================================================

JWT_SECRET_KEY=replace_with_long_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120


# ============================================================
# Compte enseignant de test
# Utilisé pour la connexion à l'interface professeur.
# ============================================================

TEACHER_USERNAME=replace_with_teacher_username
TEACHER_PASSWORD=replace_with_teacher_password