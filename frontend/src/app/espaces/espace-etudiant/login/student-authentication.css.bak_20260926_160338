:host {
  display: block;
  min-height: 100vh;
}

* {
  box-sizing: border-box;
}

.student-login-page {
  min-height: 100vh;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 42px;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 15% 15%,
      rgba(196, 0, 36, .18),
      transparent 32%
    ),
    radial-gradient(
      circle at 86% 80%,
      rgba(17, 24, 39, .18),
      transparent 35%
    ),
    linear-gradient(
      135deg,
      #17151f 0%,
      #330a1b 32%,
      #6f0627 66%,
      #c40024 100%
    );
}

.student-back-button {
  position: absolute;
  top: 24px;
  left: 28px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 12px;
  padding: 11px 16px;
  background: rgba(15,23,42,.72);
  color: #fff;
  cursor: pointer;
  font-weight: 800;
}

.student-login-shell {
  width: min(1060px, 100%);
  display: grid;
  grid-template-columns: 1.08fr .92fr;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 30px;
  background: rgba(255,255,255,.08);
  box-shadow:
    0 36px 100px rgba(0,0,0,.35);
  backdrop-filter: blur(20px);
}

.student-login-brand {
  padding: 60px;
  color: #fff;
}

.student-brand-badge,
.student-login-kicker {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 7px 12px;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .10em;
  text-transform: uppercase;
}

.student-brand-badge {
  background: rgba(255,255,255,.11);
  border: 1px solid rgba(255,255,255,.16);
}

.student-login-brand h1 {
  margin: 28px 0 18px;
  font-size: clamp(40px, 5vw, 66px);
  line-height: .95;
}

.student-login-brand h1 span {
  display: block;
  color: #ff5f78;
}

.student-login-brand > p {
  max-width: 520px;
  color: rgba(255,255,255,.76);
  font-size: 16px;
  line-height: 1.7;
}

.student-security-list {
  display: grid;
  gap: 12px;
  margin-top: 38px;
}

.student-security-list div {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 13px 15px;
  border: 1px solid rgba(255,255,255,.10);
  border-radius: 14px;
  background: rgba(255,255,255,.05);
}

.student-security-list strong {
  color: #ff7188;
  font-family: monospace;
}

.student-security-list span {
  color: rgba(255,255,255,.84);
  font-size: 13px;
}

.student-login-card {
  margin: 18px;
  padding: 42px;
  border-radius: 24px;
  background: rgba(255,255,255,.97);
  box-shadow:
    0 20px 50px rgba(15,23,42,.18);
}

.student-login-kicker {
  padding-left: 0;
  color: #c40024;
}

.student-login-card h2 {
  margin: 9px 0 8px;
  color: #111827;
  font-size: 30px;
}

.student-login-card-head p {
  margin: 0;
  color: #64748b;
}

.student-login-form {
  display: grid;
  gap: 18px;
  margin-top: 34px;
}

.student-login-form label {
  display: grid;
  gap: 8px;
}

.student-login-form label span {
  color: #334155;
  font-size: 13px;
  font-weight: 800;
}

.student-login-form input {
  width: 100%;
  height: 50px;
  border: 1px solid #dbe2ea;
  border-radius: 12px;
  padding: 0 15px;
  outline: none;
  background: #fff;
  color: #111827;
  transition: .2s ease;
}

.student-login-form input:focus {
  border-color: #c40024;
  box-shadow:
    0 0 0 4px rgba(196,0,36,.08);
}

.student-login-submit {
  height: 52px;
  margin-top: 4px;
  border: 0;
  border-radius: 12px;
  cursor: pointer;
  background:
    linear-gradient(
      135deg,
      #1b1829 0%,
      #670621 42%,
      #c40024 100%
    );
  color: #fff;
  font-weight: 900;
  font-size: 14px;
}

.student-login-submit:disabled {
  opacity: .65;
  cursor: wait;
}

.student-login-error {
  padding: 12px 14px;
  border: 1px solid #fecdd3;
  border-radius: 12px;
  background: #fff1f2;
  color: #be123c;
  font-size: 13px;
  font-weight: 700;
}

.student-login-footer {
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid #edf0f4;
  color: #94a3b8;
  text-align: center;
  font-size: 12px;
}

@media (max-width: 850px) {
  .student-login-page {
    padding: 80px 18px 28px;
  }

  .student-login-shell {
    grid-template-columns: 1fr;
  }

  .student-login-brand {
    padding: 36px;
  }

  .student-login-card {
    margin-top: 0;
  }
}


