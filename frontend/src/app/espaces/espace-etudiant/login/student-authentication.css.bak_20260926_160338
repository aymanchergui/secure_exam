  font-weight: 650;

  line-height: 1.45;
}


/* Stage centré */
.student-login-stage {
  width:
    min(
      1220px,
      calc(100% - 80px)
    );

  display: flex;

  flex-direction: column;

  align-items: center;

  margin: 0 auto;
}


/* Bloc login */
.student-login-stage .student-login-shell {
  width: 100% !important;
}


/* Cache l'ancien style de petite pastille */
.student-space-label {
  display: none !important;
}


/* Écran Full HD */
@media
  (min-width: 1200px)
  and (max-height: 900px) {

  .student-page-heading {
    margin-bottom: 18px;
  }

  .student-page-heading h1 {
    font-size: 48px;
  }

  .student-page-heading p {
    margin-top: 9px;
    font-size: 14px;
  }

}


/* Mobile */
@media (max-width: 700px) {

  .student-login-stage {
    width: 100%;
  }

  .student-page-heading {
    margin-bottom: 18px;
  }

  .student-page-heading h1 {
    font-size: 36px;
  }

  .student-page-heading p {
    max-width: 92%;
    font-size: 13px;
  }

}

/* STUDENT CENTER TITLE END */
