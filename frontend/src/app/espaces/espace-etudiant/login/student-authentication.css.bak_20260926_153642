  overflow-x: hidden !important;
  overflow-y: auto !important;
}

/* HEADER GENERAL */
.student-public-header {
  display: block;
  width: 100%;
  flex: 0 0 auto;
  position: relative;
  z-index: 100;
}

/* CONTENU LOGIN */
.student-login-content {
  position: relative;
  flex: 1 1 auto;
  min-height: 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 72px 42px 42px;
}

.student-login-content .student-login-shell {
  width: min(1060px, 100%);
  margin: 0 auto;
}

/* RETOUR ACCUEIL */
.student-back-button {
  position: absolute !important;
  top: 18px !important;
  left: 28px !important;
  z-index: 20;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 16px !important;
  border: 1px solid rgba(255,255,255,.20) !important;
  border-radius: 12px !important;
  background: rgba(15,23,42,.76) !important;
  color: #ffffff !important;
  cursor: pointer;
  font-size: 13px;
  font-weight: 800;
  box-shadow: 0 10px 24px rgba(0,0,0,.18);
  transition: transform .22s ease, background .22s ease, box-shadow .22s ease !important;
}

.student-back-arrow {
  font-size: 17px;
  transition: transform .22s ease;
}

.student-back-button:hover {
  transform: translateY(-2px);
  background: linear-gradient(135deg,#350c1c 0%,#8e0525 100%) !important;
  box-shadow: 0 15px 32px rgba(53,12,28,.38);
}

.student-back-button:hover .student-back-arrow {
  transform: translateX(-4px);
}

.student-back-button:active {
  transform: translateY(0);
}

/* LOGO SECUREEXAM */
.student-brand-logo {
  width: fit-content;
  margin: 20px 0 18px;
  padding: 8px 13px;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 14px;
  background: rgba(255,255,255,.96);
  box-shadow: 0 12px 28px rgba(0,0,0,.14);
}

.student-brand-logo img {
  display: block;
  width: auto;
  height: 44px;
  object-fit: contain;
}

/* SECURE BLANC / EXAM ROSE */
.student-login-brand h1 {
  margin-top: 0 !important;
  color: #ffffff !important;
}

.student-login-brand h1 > span {
  display: block;
  color: #ff5f78 !important;
}

/* ETAPES */
.student-security-list > div > span {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.student-security-list b {
  color: #ffffff;
  font-size: 13px;
  font-weight: 850;
}

.student-security-list small {
  color: rgba(255,255,255,.68);
  font-size: 11.5px;
  font-weight: 600;
  line-height: 1.4;
}

@media (max-width: 850px) {
  .student-login-content {
    align-items: flex-start;
    padding: 78px 18px 28px;
  }

  .student-back-button {
    left: 18px !important;
  }
}

@media (max-width: 560px) {
  .student-login-content {
    padding: 72px 12px 24px;
  }

  .student-back-button {
    left: 12px !important;
  }

  .student-brand-logo img {
    height: 36px;
  }
}

